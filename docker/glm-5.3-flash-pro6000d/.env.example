# 官方 recipe 专用镜像；PRO 6000D/SM120 兼容性需在目标机器验证。
# 验证通过后建议填写同一镜像的 repo@sha256:... 固定构建。
VLLM_IMAGE=vllm/vllm-openai:glm53-flash
MODEL_PATH=/data/models/GLM-5.3-Flash
VLLM_API_KEY=replace-with-your-api-key
PORT=20671
MAX_MODEL_LEN=409600
MAX_NUM_SEQS=50
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.90
